# ─── Apify (lead scraping) ──────────────────────────────────────────────────
# Get your token at https://console.apify.com/account/integrations
APIFY_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Apify dataset IDs (one per category you scrape)
# Run the "compass~crawler-google-places" actor first, then paste dataset IDs here.
# Format: "category_key:dataset_id,category_key:dataset_id"
# Example: "ac:abc123XYZ,phone:def456ABC"
APIFY_DATASETS=

# ─── Your business identity ─────────────────────────────────────────────────
# These appear in messages and signatures.
SENDER_NAME=Your Name
SENDER_PHONE=+91 99999 99999
SENDER_BRAND=YourBrand
SENDER_DOMAIN=yourdomain.com

# Country code for outbound numbers (no plus sign). India = 91, UK = 44, US = 1.
COUNTRY_CODE=91

# ─── Default geographic context ─────────────────────────────────────────────
# Used when a lead has no neighborhood/city set on Google Maps.
DEFAULT_AREA=Bangalore

# ─── Google Sheet CRM (optional) ────────────────────────────────────────────
# Create a service account, download JSON, save as gsheet_creds.json (gitignored).
# Share the sheet with the service account email. Paste the sheet ID below.
GOOGLE_SHEET_ID=

# ─── WhatsApp delays (seconds between sends — avoid bans) ───────────────────
MIN_DELAY_SEC=45
MAX_DELAY_SEC=90
